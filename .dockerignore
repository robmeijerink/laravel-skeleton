storage/framework/views/*
bootstrap/cache/*.php

# Version control
.git/
.gitignore

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Infrastructure & docs (keeps the build context small)
.devcontainer/
.github/
README.md
docs/
tests/

# Machine-specific tasks
Taskfile.local.yml

# AI agent config
.claude/
AGENTS.md
CLAUDE.md
