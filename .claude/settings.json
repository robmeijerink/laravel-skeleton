{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(task:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(task pun -- require:*)",
      "Bash(task pun -- update:*)",
      "Bash(task composer -- require:*)",
      "Bash(task composer -- update:*)",
      "Bash(task bun -- add:*)"
    ],
    "deny": [
      "Bash(php:*)",
      "Bash(composer:*)",
      "Bash(pun:*)",
      "Bash(punx:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(task dev:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)"
    ]
  }
}
